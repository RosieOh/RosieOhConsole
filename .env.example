# 콘솔 환경변수 — 저장소에 올리지 않는다(.env 는 .gitignore 대상)

# GitHub OAuth 앱 (Settings › Developer settings › OAuth Apps)
#   Authorization callback URL = <PUBLIC_URL>/dashapi/oauth/callback
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=

# 콘솔 주소(OAuth 되돌아올 곳, 쓰기 요청 출처 검사, https 면 쿠키 Secure) — 브라우저가 실제로 여는 주소
#   scripts/dev.bash 는 화면(Vite)을 같이 띄우면 http://localhost:5173 으로 바꿔 쓴다 → OAuth 앱 콜백도 그 주소로
PUBLIC_URL=http://localhost:8087
# PUBLIC_URL 말고도 쓰기 요청을 받아 줄 출처(쉼표로 여럿, 선택)
ALLOWED_ORIGINS=
# 다룰 저장소의 주인, 처음 관리자(쉼표로 여럿)
GITHUB_OWNER=RosieOh
CONSOLE_ADMINS=RosieOh
# 함께 다룰 GitHub 조직(쉼표로 여럿). 비공개 조직 저장소는 GITHUB_TOKEN 에 그 조직 권한이 있어야 보인다
GITHUB_ORGS=MarioChunjaeIT

# 읽기 토큰(fine-grained: Metadata·Contents·Actions read). 비우면 공개 API 한도로 돈다
GITHUB_TOKEN=
# 쓰기 토큰(Actions·Contents·Pull requests·Variables write) — 되돌리기·운영 반영 등. 비우면 그 버튼이 꺼진다
GITHUB_WRITE_TOKEN=

# 테스트배드 — API 문서·테스터가 /mxtest/* 로 대신 부른다. 비우면 꺼진다
TESTBED_URL=
# 테스트 JWT 발급(Tools) — 테스트배드 앱과 같은 시크릿
JWT_SECRET_KEY=
JWT_ISSUER=

# 서버 점검 결과 받기(probe 워크플로가 보내는 값과 같게)
PROBE_TOKEN=

# 저장 — DATABASE_URL 이 있으면 MariaDB(store·audit·blob_file 표를 스스로 만든다), 없으면 DATA_DIR 의 JSON 파일
#   docker compose up -d mariadb → mariadb://console:console@127.0.0.1:3307/console
DATABASE_URL=
# 파일 모드의 저장 위치(로컬 개발은 ./data 등으로). DB 모드에서도 옛 파일이 있으면 처음 한 번 DB 로 옮겨 온다
DATA_DIR=/data

# 웹 빌드 — 화면의 GitHub 링크 주인(GITHUB_OWNER 와 같게)
VITE_GITHUB_OWNER=RosieOh

# 백그라운드 작업 끄기(off) — 배포 흐름·러너 폴링, 연관 관계 스캔, 운영 반영 예약 실행, 카탈로그 로고 자동 선택
# GITHUB_TOKEN 없이 돌리면 공개 API 한도(시간당 60회)를 금방 쓰니 끄고 시작한다
# FLOW_POLL=off
# RUNNERS_POLL=off
# RELATIONS_SCAN=off
# PROMOTE_RUN=off
# CATALOG_AUTO_LOGO=off
